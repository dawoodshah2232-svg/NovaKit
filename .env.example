# Client-side public values (safe to expose in the browser bundle).
# Get this from Google Analytics → Admin → Data Streams → Measurement ID (G-XXXXXXXXXX).
# When set, gtag.js loads in Consent Mode (analytics denied until the visitor
# accepts the cookie notice). When empty, GA is fully disabled: no scripts load
# and no cookie banner is shown.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Server-only. Never prefix these secrets with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_PASS=
# Generate an independent random secret with at least 32 characters.
ADMIN_SESSION_SECRET=
